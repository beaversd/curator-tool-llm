# Production .env for the per-PMID pipeline (scripts/run_pmid.sh).
# Copy to .env next to run_extraction.py and fill in. Do not commit .env.
# MongoDB is not used.

# Extraction + merge (Claude)
ANTHROPIC_API_KEY=
# Review step (second opinion). Not needed with --no-review.
OPENAI_API_KEY=
# NCBI E-utilities / PMC fetch. https://account.ncbi.nlm.nih.gov/settings/
PUBMED_API_KEY=
# NCBI asks for a contact address with E-utilities requests (code default is zhenga@ohsu.edu).
NCBI_EMAIL=
NCBI_TOOL=curator-tool-llm

# Neo4j — your database for the merging step
REACTOME_NEO4J_URI=bolt://localhost:7687
REACTOME_NEO4J_USER=neo4j
REACTOME_NEO4J_PWD=
REACTOME_NEO4J_DATABASE=
